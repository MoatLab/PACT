+/*
+ * colloid: Should we migrate page away from local NUMA node due to congestion?
+ * Returns destination nid, or NUMA_NO_NODE if no migration needed.
+ */
+int numa_migrate_memory_away_target(struct page *page, int src_nid)
+{
+	unsigned int latency, th;
+
+	if (!(sysctl_numa_balancing_mode & NUMA_BALANCING_MEMORY_TIERING &&
+	      sysctl_numa_balancing_mode & NUMA_BALANCING_COLLOID))
+		return NUMA_NO_NODE;
+
+	if (src_nid != colloid_nid_of_interest)
+		return NUMA_NO_NODE;
+
+	if (!READ_ONCE(colloid_local_lat_gt_remote))
+		return NUMA_NO_NODE;
+
+	/* Local memory is congested */
+	if (sysctl_numa_balancing_mode & NUMA_BALANCING_NORMAL) {
+		/* No timestamp, use active/inactive list to determine hotness */
+		if (!PageActive(page)) {
+			mark_page_accessed(page);
+			return NUMA_NO_NODE;
+		}
+	} else {
+		/* Timestamp in page flags, use hint fault latency */
+		th = NODE_DATA(src_nid)->nbp_threshold ? :
+			sysctl_numa_balancing_hot_threshold;
+		latency = numa_hint_fault_latency(page);
+		if (latency >= th)
+			return NUMA_NO_NODE;
+	}
+
+	return next_demotion_node(src_nid);
+}
