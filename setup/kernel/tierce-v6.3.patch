+/*
+ * Returns true if this is a safe migration target node for misplaced NUMA
+ * pages. Currently it only checks the watermarks which is crude.
+ */
+static bool migrate_balanced_pgdat(struct pglist_data *pgdat,
+				   unsigned long nr_migrate_pages)
+{
+	int z;
+
+	for (z = pgdat->nr_zones - 1; z >= 0; z--) {
+		struct zone *zone = pgdat->node_zones + z;
+
+		if (!managed_zone(zone))
+			continue;
+
+		/* Avoid waking kswapd by allocating pages_to_migrate pages. */
+		if (!zone_watermark_ok(zone, 0,
+				       high_wmark_pages(zone) +
+				       nr_migrate_pages,
+				       ZONE_MOVABLE, 0))
+			continue;
+		return true;
+	}
+	return false;
+}
+
+static bool cgroup_migrate_balanced_pgdat(struct pglist_data *pgdat,
+				   unsigned long nr_migrate_pages, struct mem_cgroup *memcg, int node)
+{
+	struct zone *normal = &pgdat->node_zones[ZONE_NORMAL];
+	unsigned long max_nr_pages, used_nr_pages, free_nr_pages;
+	max_nr_pages = memcg_get_node_limit(memcg, node);
+	used_nr_pages = memcg_get_node_usedpages(memcg, pgdat);
+
+	if (max_nr_pages == ULONG_MAX)
+		return true;
+
+	if (used_nr_pages > max_nr_pages)
+		free_nr_pages = 0;
+	else
+		free_nr_pages = max_nr_pages - used_nr_pages;
+
+	return _memcg_watermark_ok(normal, 0,
+				       high_wmark_pages(normal) +
+				       nr_migrate_pages,
+				       ZONE_MOVABLE, free_nr_pages, max_nr_pages);
+}
+
+/*
+ * The node limit check of move_pages(2). nr_migrate_pages counts the page
+ * to move and the pages queued earlier in the same call, which are not on
+ * this node until the queue migrates. They are subtracted from the free
+ * space under the limit before the scaling to the zone size, so that the
+ * count needs its real room under the limit. The NUMA balancing check above
+ * keeps its own order.
+ */
+static bool cgroup_move_pages_room_ok(struct pglist_data *pgdat,
+				unsigned long nr_migrate_pages, struct mem_cgroup *memcg, int node)
+{
+	struct zone *normal = &pgdat->node_zones[ZONE_NORMAL];
+	unsigned long max_nr_pages, used_nr_pages, free_nr_pages;
+
+	max_nr_pages = memcg_get_node_limit(memcg, node);
+	if (max_nr_pages == ULONG_MAX)
+		return true;
+
+	used_nr_pages = memcg_get_node_usedpages(memcg, pgdat);
+	if (used_nr_pages + nr_migrate_pages >= max_nr_pages)
+		return false;
+	free_nr_pages = max_nr_pages - used_nr_pages - nr_migrate_pages;
+
+	return _memcg_watermark_ok(normal, 0, high_wmark_pages(normal),
+				       ZONE_MOVABLE, free_nr_pages, max_nr_pages);
+}
