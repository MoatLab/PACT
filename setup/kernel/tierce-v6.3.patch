+/*
+ * MMCTL: only ZONE_NORMAL is checked. The free space of the cgroup under its
+ * node limit is compared with the zone watermarks, scaled to that limit.
+ */
+static bool memcg_free_space_enough(struct pglist_data *pgdat,
+					struct mem_cgroup *memcg, unsigned long max_nr_pages)
+{
+	unsigned long enough_wmark;
+	struct zone *normal;
+	unsigned long used_nr_pages = 0, free_nr_pages;
+	bool result;
+
+	enough_wmark = max(1UL * 1024 * 1024 * 1024 >> PAGE_SHIFT,
+			   pgdat->node_present_pages >> 4);
+
+	used_nr_pages = memcg_get_node_usedpages(memcg, pgdat);
+
+	if(used_nr_pages > max_nr_pages)
+		return false;
+
+	free_nr_pages = max_nr_pages - used_nr_pages;
+	normal = &pgdat->node_zones[ZONE_NORMAL];
+
+	result = _memcg_watermark_ok(normal, 0, wmark_pages(normal, WMARK_PROMO)
+				+ enough_wmark, ZONE_MOVABLE, free_nr_pages, max_nr_pages);
+
+	return result;
+}
