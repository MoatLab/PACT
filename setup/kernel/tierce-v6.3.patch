+static void kdemotiond_stop(struct mem_cgroup *memcg, int nid);
+
+/* Stop every kdemotiond thread of the cgroup. */
+static void kdemotiond_stop_all(struct mem_cgroup *memcg)
+{
+	int nid;
+
+	for_each_node_state(nid, N_MEMORY) {
+		struct mem_cgroup_per_node *pn = memcg->nodeinfo[nid];
+
+		if (pn && pn->kdemotiond)
+			kdemotiond_stop(memcg, nid);
+	}
+}
+#endif
