+static void numa_cgroup_promotion_adjust_threshold(struct mem_cgroup_per_node *pn,
+					    unsigned long rate_limit,
+					    unsigned int ref_th)
+{
+	unsigned int now, start, th_period, unit_th, th;
+	unsigned long nr_cand, ref_cand, diff_cand;
+	struct memcg_migration_ctl *mig = &pn->mig;
+
+	now = jiffies_to_msecs(jiffies);
+	th_period = sysctl_numa_balancing_scan_period_max;
+	start = mig->nbp_th_start;
+	if (now - start > th_period &&
+	    cmpxchg(&mig->nbp_th_start, start, now) == start) {
+		ref_cand = rate_limit *
+			sysctl_numa_balancing_scan_period_max / MSEC_PER_SEC;
+		nr_cand = cgroup_node_page_state_get(pn, CGROUP_PGPROMOTE_CANDIDATE);
+		diff_cand = nr_cand - mig->nbp_th_nr_cand;
+		unit_th = ref_th * 2 / NUMA_MIGRATION_ADJUST_STEPS;
+		th = mig->nbp_threshold ? : ref_th;
+		if (diff_cand > ref_cand * 11 / 10)
+			th = max(th - unit_th, unit_th);
+		else if (diff_cand < ref_cand * 9 / 10)
+			th = min(th + unit_th, ref_th * 2);
+		WRITE_ONCE(mig->nbp_th_nr_cand, nr_cand);
+		mig->nbp_threshold = th;
+	}
+}
+
+static bool numa_cgroup_promotion_rate_limit(struct mem_cgroup_per_node *pn,
+				      unsigned long rate_limit, int nr)
+{
+	unsigned long nr_cand;
+	unsigned int now, start;
+	struct memcg_migration_ctl *mig = &pn->mig;
+
+	now = jiffies_to_msecs(jiffies);
+	cgroup_node_page_state_add(pn, CGROUP_PGPROMOTE_CANDIDATE, nr);
+	nr_cand = cgroup_node_page_state_get(pn, CGROUP_PGPROMOTE_CANDIDATE);
+	start = mig->nbp_rl_start;
+	if (now - start > MSEC_PER_SEC &&
+	    cmpxchg(&mig->nbp_rl_start, start, now) == start)
+		WRITE_ONCE(mig->nbp_rl_nr_cand, nr_cand);
+	if (nr_cand - mig->nbp_rl_nr_cand >= rate_limit)
+		return true;
+	return false;
+}
