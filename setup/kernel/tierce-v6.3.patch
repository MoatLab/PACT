+
+bool memcg_can_demote(struct mem_cgroup *memcg)
+{
+	if (memcg_nodectl_status(memcg) && memcg->demotion_enabled)
+		return true;
+
+	return false;
+}
+
+unsigned long memcg_get_node_usedpages(struct mem_cgroup *memcg, pg_data_t *pgdat)
+{
+	struct lruvec *lruvec;
+	unsigned long nr_pages = 0;
+	enum lru_list lru;
+
+	/*
+	 * Read the per-node usage from the LRU list sizes of the cgroup on
+	 * this node. Migration moves a folio to the lruvec of the target node,
+	 * so lruvec_lru_size() counts the folios resident on this node.
+	 */
+	lruvec = mem_cgroup_lruvec(memcg, pgdat);
+
+	for_each_lru(lru)
+		nr_pages += lruvec_lru_size(lruvec, lru, MAX_NR_ZONES - 1);
+
+	return nr_pages;
+}
+
+unsigned long zone_wmark_to_memcg(struct zone *z, int wmark,
+				struct mem_cgroup *memcg, int nid)
+{
+	long managed_pages;
+	unsigned long max_nr_pages = memcg_get_node_limit(memcg, nid);
+
+	/*
+	 * No limit: kdemotiond can read this value before kdemotiond_stop()
+	 * ends it. Do not scale.
+	 */
+	if (max_nr_pages == ULONG_MAX)
+		return wmark;
+
+	managed_pages = atomic_long_read(&z->managed_pages);
+	return mult_frac(wmark, max_nr_pages, managed_pages);
+}
+
+bool memcg_watermark_ok(pg_data_t *pgdat, struct mem_cgroup *memcg,
+				unsigned int order, unsigned long mark,
+				int highest_zoneidx)
+{
+	int nid = pgdat->node_id;
+	unsigned long max_nr_pages = memcg_get_node_limit(memcg, nid);
+	unsigned long used_nr_pages = memcg_get_node_usedpages(memcg, pgdat);
+	unsigned long free_nr_pages;
+	struct zone *normal = &pgdat->node_zones[ZONE_NORMAL];
+
+	/* No limit on this node: nothing to demote. */
+	if (max_nr_pages == ULONG_MAX)
+		return true;
+
+	if (used_nr_pages > max_nr_pages)
+		return false;
+
+	free_nr_pages = max_nr_pages - used_nr_pages;
+	return _memcg_watermark_ok(normal, order, mark, highest_zoneidx,
+				free_nr_pages, max_nr_pages);
+}
+
+/* Only ZONE_NORMAL is checked. */
+bool _memcg_watermark_ok(struct zone *z, unsigned int order,
+				unsigned long mark, int highest_zoneidx,
+				unsigned long free_nr_pages,
+				unsigned long max_nr_pages)
+{
+	unsigned long free_nr_pages_scaled;
+	long managed_pages;
+
+	/* A limit of 0 pages leaves no room, and the scaling divides by it. */
+	if (!max_nr_pages)
+		return false;
+
+	managed_pages = atomic_long_read(&z->managed_pages);
+	free_nr_pages_scaled = mult_frac(free_nr_pages, managed_pages, max_nr_pages);
+
+	return __zone_watermark_ok(z, order, mark, highest_zoneidx, 0,
+				free_nr_pages_scaled);
+}
+
+static bool memcg_pgdat_balanced(pg_data_t *pgdat, struct mem_cgroup *memcg, int order)
+{
+	unsigned long mark = -1;
+	struct zone *zone = &pgdat->node_zones[ZONE_NORMAL];
+
+	if (!managed_zone(zone))
+		goto out;
+
+	mark = wmark_pages(zone, WMARK_PROMO);
+
+	if (memcg_watermark_ok(pgdat, memcg, order, mark, ZONE_NORMAL))
+		return true;
+
+out:
+	if (mark == -1)
+		return true;
+
+	return false;
+}
+
+void wakeup_kdemotiond(struct mem_cgroup_per_node *pn, struct zone *zone, gfp_t gfp_flags, int order)
+{
+	if (!managed_zone(zone))
+		return;
+
+	if (!cpuset_zone_allowed(zone, gfp_flags))
+		return;
+
+	if (READ_ONCE(pn->kdemotiond_order) < order)
+		WRITE_ONCE(pn->kdemotiond_order, order);
+
+	if (!waitqueue_active(&pn->kdemotiond_wait))
+		return;
+
+	wake_up_interruptible(&pn->kdemotiond_wait);
+}
+
+static bool prepare_kdemotiond_sleep(pg_data_t *pgdat, struct mem_cgroup *memcg, int order)
+{
+	if (memcg_pgdat_balanced(pgdat, memcg, order)) {
+		return true;
+	}
+
+	return false;
+}
+
+static void kdemotiond_try_to_sleep(pg_data_t *pgdat, struct mem_cgroup_per_node *pn,
+						int alloc_order, int reclaim_order)
+{
+	long remaining = 0;
+	DEFINE_WAIT(wait);
+
+	if (freezing(current) || kthread_should_stop())
+		return;
+
+	prepare_to_wait(&pn->kdemotiond_wait, &wait, TASK_INTERRUPTIBLE);
+
+	if (prepare_kdemotiond_sleep(pgdat, pn->memcg, reclaim_order)) {
+
+		remaining = schedule_timeout(HZ/10);
+
+		if (remaining) {
+			if (READ_ONCE(pn->kdemotiond_order) < reclaim_order)
+				WRITE_ONCE(pn->kdemotiond_order, reclaim_order);
+		}
+
+		finish_wait(&pn->kdemotiond_wait, &wait);
+		prepare_to_wait(&pn->kdemotiond_wait, &wait, TASK_INTERRUPTIBLE);
+	}
+
+	if (!remaining &&
+	    prepare_kdemotiond_sleep(pgdat, pn->memcg, reclaim_order)) {
+
+		set_pgdat_percpu_threshold(pgdat, calculate_normal_threshold);
+
+		if (!kthread_should_stop())
+			schedule();
+
+		set_pgdat_percpu_threshold(pgdat, calculate_pressure_threshold);
+	}
+
+	finish_wait(&pn->kdemotiond_wait, &wait);
+}
+
+static void kdemotiond_age_memcg(struct pglist_data *pgdat, struct scan_control *sc)
+{
+	struct lruvec *lruvec;
+
+	if (lru_gen_enabled()) {
+		BUG();
+		return;
+	}
+
+	if (!can_age_anon_pages(pgdat, sc)) {
+		pr_debug("kdemotiond_age_memcg: Cannot age anon pages, skipping\n");
+		return;
+	}
+
+	pr_debug("kdemotiond_age_memcg: Aging anon pages for memcg=%s node=%d\n",
+		 sc->target_mem_cgroup ? sc->target_mem_cgroup->css.cgroup->kn->name : "root",
+		 pgdat->node_id);
+
+	lruvec = mem_cgroup_lruvec(sc->target_mem_cgroup, pgdat);
+	shrink_active_list(SWAP_CLUSTER_MAX, lruvec,
+				sc, LRU_ACTIVE_ANON);
+
+	pr_debug("kdemotiond_age_memcg: Finished aging\n");
+}
+
+static bool kdemotiond_shrink_node(pg_data_t *pgdat,
+			       struct scan_control *sc)
+{
+	struct zone *zone = &pgdat->node_zones[ZONE_NORMAL];
+	unsigned long wmark = zone_wmark_to_memcg(zone, high_wmark_pages(zone),
+								sc->target_mem_cgroup, pgdat->node_id);
+	unsigned long nr_reclaimed_before = sc->nr_reclaimed;
+	unsigned long nr_scanned_before = sc->nr_scanned;
+
+	sc->nr_to_reclaim = max(wmark, SWAP_CLUSTER_MAX);
+
+	pr_debug("kdemotiond_shrink_node: node=%d wmark=%lu nr_to_reclaim=%lu\n",
+		 pgdat->node_id, wmark, sc->nr_to_reclaim);
+
+	shrink_node(pgdat, sc);
+
+	pr_debug("kdemotiond_shrink_node: Shrunk node, reclaimed=%lu scanned=%lu (delta: +%lu/+%lu)\n",
+		 sc->nr_reclaimed, sc->nr_scanned,
+		 sc->nr_reclaimed - nr_reclaimed_before,
+		 sc->nr_scanned - nr_scanned_before);
+
+	if (sc->order && sc->nr_reclaimed >= compact_gap(sc->order))
+		sc->order = 0;
+
+	return sc->nr_scanned >= sc->nr_to_reclaim;
+}
+
+/*
+ * For kswapd, balance_pgdat() will reclaim pages across a node from zones
+ * that are eligible for use by the caller until at least one zone is
+ * balanced.
+ *
+ * Returns the order kswapd finished reclaiming at.
+ *
+ * kswapd scans the zones in the highmem->normal->dma direction.  It skips
+ * zones which have free_pages > high_wmark_pages(zone), but once a zone is
+ * found to have free_pages <= high_wmark_pages(zone), any page in that zone
+ * or lower is eligible for reclaim until at least one usable zone is
+ * balanced.
+ */
+static int memcg_balance_pgdat(pg_data_t *pgdat, int order, int highest_zoneidx,
+					struct mem_cgroup_per_node *pn, bool *no_progress)
+{
+	int i;
+	unsigned long pflags;
+	unsigned long nr_boost_reclaim;
+	unsigned long zone_boosts[MAX_NR_ZONES] = { 0, };
+	bool boosted;
+	struct zone *zone;
+	struct scan_control sc = {
+		.gfp_mask = GFP_KERNEL,
+		.order = order,
+		.may_unmap = 1,
+	};
+
+	struct mem_cgroup *memcg = pn->memcg;
+	sc.target_mem_cgroup = memcg;
+	*no_progress = false;
+
+	pr_debug("memcg_balance_pgdat: Start for memcg=%s node=%d order=%d highest_zoneidx=%d\n",
+		 memcg ? memcg->css.cgroup->kn->name : "root", pgdat->node_id, order, highest_zoneidx);
+
+	set_task_reclaim_state(current, &sc.reclaim_state);
+	psi_memstall_enter(&pflags);
+	__fs_reclaim_acquire(_THIS_IP_);
+
+	count_vm_event(PAGEOUTRUN);
+
+	/*
+	 * Account for the reclaim boost. Note that the zone boost is left in
+	 * place so that parallel allocations that are near the watermark will
+	 * stall or direct reclaim until kswapd is finished.
+	 */
+	nr_boost_reclaim = 0;
+	for (i = 0; i <= highest_zoneidx; i++) {
+		zone = pgdat->node_zones + i;
+		if (!managed_zone(zone))
+			continue;
+
+		nr_boost_reclaim += zone->watermark_boost;
+		zone_boosts[i] = zone->watermark_boost;
+	}
+	boosted = nr_boost_reclaim;
+
+restart:
+	set_reclaim_active(pgdat, highest_zoneidx);
+	sc.priority = DEF_PRIORITY;
+	pr_debug("memcg_balance_pgdat: Entering reclaim loop, boosted=%d nr_boost_reclaim=%lu\n",
+		 boosted, nr_boost_reclaim);
+	do {
+		unsigned long nr_reclaimed = sc.nr_reclaimed;
+		bool raise_priority = true;
+		bool balanced;
+		bool ret;
+
+		sc.reclaim_idx = highest_zoneidx;
+
+		balanced = memcg_pgdat_balanced(pgdat, memcg, sc.order);
+		pr_debug("memcg_balance_pgdat: priority=%d balanced=%d nr_boost_reclaim=%lu total_reclaimed=%lu\n",
+			 sc.priority, balanced, nr_boost_reclaim, sc.nr_reclaimed);
+		if (!balanced && nr_boost_reclaim) {
+			nr_boost_reclaim = 0;
+			goto restart;
+		}
+
+		if (!nr_boost_reclaim && balanced)
+			goto out;
+
+		if (nr_boost_reclaim && sc.priority == DEF_PRIORITY - 2)
+			raise_priority = false;
+
+		sc.may_writepage = !laptop_mode && !nr_boost_reclaim;
+		sc.may_swap = !nr_boost_reclaim;
+
+		/*
+		 * Do some background aging, to give pages a chance to be
+		 * referenced before reclaiming. All pages are rotated
+		 * regardless of classzone as this is about consistent aging.
+		 */
+		pr_debug("memcg_balance_pgdat: Calling kdemotiond_age_memcg, priority=%d\n", sc.priority);
+		/*
+		 * Flush the per-CPU pagevecs, so that recently faulted pages
+		 * are on the LRU lists that kdemotiond scans.
+		 */
+		lru_add_drain_all();
+		kdemotiond_age_memcg(pgdat, &sc);
+		pr_debug("memcg_balance_pgdat: After kdemotiond_age_memcg\n");
+
+		if (sc.priority < DEF_PRIORITY - 2)
+			sc.may_writepage = 1;
+
+		/* Assume there is no soft limit*/
+		sc.nr_scanned = 0;
+
+		/*
+		 * There should be no need to raise the scanning priority if
+		 * enough pages are already being scanned that that high
+		 * watermark would be met at 100% efficiency.
+		 */
+		pr_debug("memcg_balance_pgdat: Calling kdemotiond_shrink_node, nr_scanned=%lu\n", sc.nr_scanned);
+		if (kdemotiond_shrink_node(pgdat, &sc))
+			raise_priority = false;
+		pr_debug("memcg_balance_pgdat: After kdemotiond_shrink_node, nr_scanned=%lu raise_priority=%d\n",
+			 sc.nr_scanned, raise_priority);
+
+		/*
+		 * If the low watermark is met there is no need for processes
+		 * to be throttled on pfmemalloc_wait as they should not be
+		 * able to safely make forward progress. Wake them
+		 */
+
+		/* Check if kswapd should be suspending */
+		__fs_reclaim_release(_THIS_IP_);
+		ret = try_to_freeze();
+		__fs_reclaim_acquire(_THIS_IP_);
+		if (ret || kthread_should_stop())
+			break;
+
+		/*
+		 * Raise priority if scanning rate is too low or there was no
+		 * progress in reclaiming pages
+		 */
+		nr_reclaimed = sc.nr_reclaimed - nr_reclaimed;
+		nr_boost_reclaim -= min(nr_boost_reclaim, nr_reclaimed);
+
+		pr_debug("memcg_balance_pgdat: Round reclaimed=%lu total_reclaimed=%lu nr_boost_reclaim=%lu\n",
+			 nr_reclaimed, sc.nr_reclaimed, nr_boost_reclaim);
+
+		/*
+		 * If reclaim made no progress for a boost, stop reclaim as
+		 * IO cannot be queued and it could be an infinite loop in
+		 * extreme circumstances.
+		 */
+		if (nr_boost_reclaim && !nr_reclaimed)
+			break;
+
+		if (raise_priority || !nr_reclaimed)
+			sc.priority--;
+	} while (sc.priority >= 1);
+
+	if (!sc.nr_reclaimed) {
+		pgdat->kswapd_failures++;
+		/* The cgroup was not balanced, and this round freed nothing. */
+		*no_progress = true;
+	}
+
+out:
+	pr_debug("memcg_balance_pgdat: Exiting, total_reclaimed=%lu final_priority=%d\n",
+		 sc.nr_reclaimed, sc.priority);
+	clear_reclaim_active(pgdat, highest_zoneidx);
+
+	/* If reclaim was boosted, account for the reclaim done in this pass */
+	if (boosted) {
+		unsigned long flags;
+
+		for (i = 0; i <= highest_zoneidx; i++) {
+			if (!zone_boosts[i])
+				continue;
+
+			/* Increments are under the zone lock */
+			zone = pgdat->node_zones + i;
+			spin_lock_irqsave(&zone->lock, flags);
+			zone->watermark_boost -= min(zone->watermark_boost, zone_boosts[i]);
+			spin_unlock_irqrestore(&zone->lock, flags);
+		}
+
+		/*
+		 * As there is now likely space, wakeup kcompact to defragment
+		 * pageblocks.
+		 */
+		wakeup_kcompactd(pgdat, pageblock_order, highest_zoneidx);
+	}
+
+	snapshot_refaults(memcg, pgdat);
+	__fs_reclaim_release(_THIS_IP_);
+	psi_memstall_leave(&pflags);
+	set_task_reclaim_state(current, NULL);
+
+	/*
+	 * Return the order kswapd stopped reclaiming at as
+	 * prepare_kswapd_sleep() takes it into account. If another caller
+	 * entered the allocator slow path while kswapd was awake, order will
+	 * remain at the higher level.
+	 */
+	return sc.order;
+}
+
+static int kdemotiond(void *p)
+{
+	unsigned int alloc_order, reclaim_order;
+	struct mem_cgroup_per_node *pn = (struct mem_cgroup_per_node *)p;
+	struct task_struct *tsk = current;
+	const struct cpumask *cpumask = cpumask_of_node(pn->nid);
+	pg_data_t *pgdat = NODE_DATA(pn->nid);
+
+	if (!cpumask_empty(cpumask))
+		set_cpus_allowed_ptr(tsk, cpumask);
+
+	tsk->flags |= PF_MEMALLOC | PF_KSWAPD;
+	set_freezable();
+
+	WRITE_ONCE(pn->kdemotiond_order, 0);
+	for (;;) {
+		bool ret, no_progress;
+
+		alloc_order = reclaim_order = READ_ONCE(pn->kdemotiond_order);
+
+kdemotiond_try_sleep:
+		kdemotiond_try_to_sleep(pgdat, pn, alloc_order, reclaim_order);
+
+		alloc_order = READ_ONCE(pn->kdemotiond_order);
+		WRITE_ONCE(pn->kdemotiond_order, 0);
+
+		ret = try_to_freeze();
+		if (kthread_should_stop())
+			break;
+
+		/*
+		 * We can speed up thawing tasks if we don't call balance_pgdat
+		 * after returning from the refrigerator
+		 */
+		if (ret)
+			continue;
+
+		/*
+		 * Reclaim begins at the requested order but if a high-order
+		 * reclaim fails then kswapd falls back to reclaiming for
+		 * order-0. If that happens, kswapd will consider sleeping
+		 * for the order it finished reclaiming at (reclaim_order)
+		 * but kcompactd is woken to compact for the original
+		 * request (alloc_order).
+		 */
+		reclaim_order = memcg_balance_pgdat(pgdat, alloc_order, ZONE_NORMAL, pn,
+						    &no_progress);
+		/*
+		 * A round that reclaims nothing leaves the cgroup unbalanced,
+		 * so kdemotiond_try_to_sleep() would not sleep and the next
+		 * round would start at once. Nap for 100 ms first, as after a
+		 * balanced round. A refused promotion does not end this nap: it
+		 * only records its order, which the next round uses.
+		 */
+		if (no_progress && !kthread_should_stop())
+			schedule_timeout_interruptible(HZ / 10);
+		if (reclaim_order < alloc_order)
+			goto kdemotiond_try_sleep;
+	}
+
+	tsk->flags &= ~(PF_MEMALLOC | PF_KSWAPD);
+
+	return 0;
+}
+
+/*
+ * Start the cgroup's kdemotiond for node nid. Returns 0, or the error of
+ * kthread_run(). The cgroup file write that asked for the thread returns
+ * that error, so the writer sees that no thread enforces the limit.
+ */
+static int kdemotiond_run(struct mem_cgroup *memcg, int nid)
+{
+	char cgname[NAME_MAX];
+	struct mem_cgroup_per_node *pn = memcg->nodeinfo[nid];
+	struct task_struct *tsk;
+	int err = 0;
+
+	cgroup_name(memcg->css.cgroup, cgname, sizeof(cgname));
+	memcg_kdemotiond_lock(pn);
+	if (!pn->kdemotiond) {
+		tsk = kthread_run(kdemotiond, pn, "kdemotiond_%s_%d", cgname, nid);
+		if (IS_ERR(tsk)) {
+			/* failure at boot is fatal */
+			BUG_ON(system_state < SYSTEM_RUNNING);
+			err = PTR_ERR(tsk);
+			pr_err("Failed to start kdemotiond_%s_%d: %d\n", cgname, nid, err);
+		} else {
+			pn->kdemotiond = tsk;
+		}
+	}
+	memcg_kdemotiond_unlock(pn);
+	return err;
+}
+
+/* Start kdemotiond for every node of the cgroup that has a limit. */
+static int kdemotiond_run_limited(struct mem_cgroup *memcg)
+{
+	int nid, err = 0;
+
+	for_each_node_state(nid, N_MEMORY) {
+		struct mem_cgroup_per_node *pn = memcg->nodeinfo[nid];
+
+		if (pn->max_nr_base_pages != ULONG_MAX && !pn->kdemotiond) {
+			int ret = kdemotiond_run(memcg, nid);
+
+			if (ret && !err)
+				err = ret;
+		}
+	}
+	return err;
+}
+
+static void kdemotiond_stop(struct mem_cgroup *memcg, int nid)
+{
+	struct mem_cgroup_per_node *pn = memcg->nodeinfo[nid];
+	struct task_struct *kdemotiond;
+
+	memcg_kdemotiond_lock(pn);
+	kdemotiond = pn->kdemotiond;
+	if (kdemotiond) {
+		kthread_stop(kdemotiond);
+		pn->kdemotiond = NULL;
+	}
+	memcg_kdemotiond_unlock(pn);
+}
+
+static int memcg_htmm_show(struct seq_file *m, void *v)
+{
+    struct mem_cgroup *memcg = mem_cgroup_from_css(seq_css(m));
+
+    if (memcg->mmctl_enabled)
+	seq_printf(m, "[enabled] disabled\n");
+    else
+	seq_printf(m, "enabled [disabled]\n");
+
+    return 0;
+}
+
+static ssize_t memcg_htmm_write(struct kernfs_open_file *of,
+	char *buf, size_t nbytes, loff_t off)
+{
+	struct mem_cgroup *memcg = mem_cgroup_from_css(of_css(of));
+	int err = 0;
+
+	mutex_lock(&memcg->mmctl_lock);
+	if (sysfs_streq(buf, "enabled")) {
+		memcg->mmctl_enabled = true;
+		/* Start kdemotiond for nodes with finite limits */
+		if (memcg->demotion_enabled)
+			err = kdemotiond_run_limited(memcg);
+	} else if (sysfs_streq(buf, "disabled")) {
+		memcg->mmctl_enabled = false;
+		kdemotiond_stop_all(memcg);
+	} else {
+		err = -EINVAL;
+	}
+	mutex_unlock(&memcg->mmctl_lock);
+
+	return err ? err : nbytes;
+}
+
+static struct cftype memcg_htmm_file[] = {
+    {
+	.name = "mmctl_enabled",
+	.flags = CFTYPE_NOT_ON_ROOT,
+	.seq_show = memcg_htmm_show,
+	.write = memcg_htmm_write,
+    },
+    {}, /* terminate */
+};
+
+static int __init mem_cgroup_htmm_init(void)
+{
+    WARN_ON(cgroup_add_dfl_cftypes(&memory_cgrp_subsys,
+		memcg_htmm_file));
+    return 0;
+}
+subsys_initcall(mem_cgroup_htmm_init);
+
+static int memcg_per_node_max_show(struct seq_file *m, void *v)
+{
+    struct mem_cgroup *memcg = mem_cgroup_from_css(seq_css(m));
+    struct cftype *cur_file = seq_cft(m);
+    int nid = cur_file->numa_node_id;
+    unsigned long max = READ_ONCE(memcg->nodeinfo[nid]->max_nr_base_pages);
+
+    if (max == ULONG_MAX)
+	seq_puts(m, "max\n");
+    else
+	seq_printf(m, "%llu\n", (u64)max * PAGE_SIZE);
+
+    return 0;
+}
+
+static ssize_t memcg_per_node_max_write(struct kernfs_open_file *of,
+	char *buf, size_t nbytes, loff_t off)
+{
+	struct mem_cgroup *memcg = mem_cgroup_from_css(of_css(of));
+	struct cftype *cur_file = of_cft(of);
+	int nid = cur_file->numa_node_id;
+	unsigned long max, nr_dram_pages = 0;
+	int err, n;
+	struct mem_cgroup_per_node *pn = memcg->nodeinfo[nid];
+
+	buf = strstrip(buf);
+	err = page_counter_memparse(buf, "max", &max);
+	if (err)
+		return err;
+
+	/*
+	 * page_counter_memparse() stores PAGE_COUNTER_MAX for "max" and caps
+	 * larger byte values at it. Every "no limit" test of this field
+	 * compares with ULONG_MAX, the initial value, so store ULONG_MAX.
+	 */
+	if (max == PAGE_COUNTER_MAX)
+		max = ULONG_MAX;
+
+	mutex_lock(&memcg->mmctl_lock);
+	xchg(&memcg->nodeinfo[nid]->max_nr_base_pages, max);
+
+	for_each_node_state(n, N_MEMORY) {
+		if (node_is_toptier(n)) {
+			if (memcg->nodeinfo[n]->max_nr_base_pages != ULONG_MAX)
+				nr_dram_pages += memcg->nodeinfo[n]->max_nr_base_pages;
+		}
+	}
+	if (nr_dram_pages)
+		memcg->max_nr_dram_pages = nr_dram_pages;
+
+	if (max == ULONG_MAX && pn->kdemotiond) {
+		kdemotiond_stop(memcg, nid);
+	} else if (max != ULONG_MAX && memcg->mmctl_enabled &&
+		   memcg->demotion_enabled && !pn->kdemotiond) {
+		err = kdemotiond_run(memcg, nid);
+	}
+	mutex_unlock(&memcg->mmctl_lock);
+
+	return err ? err : nbytes;
+}
+
+static int pgdat_memcg_htmm_init(struct pglist_data *pgdat)
+{
+    pgdat->memcg_htmm_file = kzalloc(2 * sizeof(struct cftype), GFP_KERNEL);
+    if (!pgdat->memcg_htmm_file) {
+	pr_err("Failed to allocate pgdat->memcg_htmm_file\n");
+	return -ENOMEM;
+    }
+#ifdef CONFIG_LOCKDEP
+    lockdep_register_key(&(pgdat->memcg_htmm_file->lockdep_key));
+#endif
+    return 0;
+}
+
+int mem_cgroup_per_node_htmm_init(void)
+{
+    int nid;
+
+    for_each_node_state(nid, N_MEMORY) {
+	struct pglist_data *pgdat = NODE_DATA(nid);
+
+	if (!pgdat || pgdat->memcg_htmm_file)
+	    continue;
+	if (pgdat_memcg_htmm_init(pgdat))
+	    continue;
+
+	snprintf(pgdat->memcg_htmm_file[0].name, MAX_CFTYPE_NAME,
+		"max_at_node%d", nid);
+	pgdat->memcg_htmm_file[0].flags = CFTYPE_NOT_ON_ROOT;
+	pgdat->memcg_htmm_file[0].seq_show = memcg_per_node_max_show;
+	pgdat->memcg_htmm_file[0].write = memcg_per_node_max_write;
+	pgdat->memcg_htmm_file[0].numa_node_id = nid;
+
+	WARN_ON(cgroup_add_dfl_cftypes(&memory_cgrp_subsys,
+		    pgdat->memcg_htmm_file));
+    }
+    return 0;
+}
+subsys_initcall(mem_cgroup_per_node_htmm_init);
+
+static int memcg_demotion_show(struct seq_file *m, void *v)
+{
+    struct mem_cgroup *memcg = mem_cgroup_from_css(seq_css(m));
+
+    if (memcg->demotion_enabled)
+		seq_printf(m, "[enabled] disabled\n");
+    else
+		seq_printf(m, "enabled [disabled]\n");
+
+    return 0;
+}
+
+static ssize_t memcg_demotion_write(struct kernfs_open_file *of,
+	char *buf, size_t nbytes, loff_t off)
+{
+	struct mem_cgroup *memcg = mem_cgroup_from_css(of_css(of));
+	int err = 0;
+
+	mutex_lock(&memcg->mmctl_lock);
+	if (sysfs_streq(buf, "enabled")) {
+		memcg->demotion_enabled = true;
+		/* Start kdemotiond for nodes with finite limits */
+		if (memcg->mmctl_enabled)
+			err = kdemotiond_run_limited(memcg);
+	} else if (sysfs_streq(buf, "disabled")) {
+		memcg->demotion_enabled = false;
+		kdemotiond_stop_all(memcg);
+	} else {
+		err = -EINVAL;
+	}
+	mutex_unlock(&memcg->mmctl_lock);
+
+	return err ? err : nbytes;
+}
+
+static struct cftype memcg_demotion_file[] = {
+    {
+	.name = "demotion",
+	.flags = CFTYPE_NOT_ON_ROOT,
+	.seq_show = memcg_demotion_show,
+	.write = memcg_demotion_write,
+    },
+    {}, /* terminate */
+};
+
+static int __init mem_cgroup_demotion_init(void)
+{
+    WARN_ON(cgroup_add_dfl_cftypes(&memory_cgrp_subsys,
+		memcg_demotion_file));
+    return 0;
+}
+subsys_initcall(mem_cgroup_demotion_init);
+
+static int memcg_promotion_counter_show(struct seq_file *m, void *v)
+{
+    struct mem_cgroup *memcg = mem_cgroup_from_css(seq_css(m));
+	seq_printf(m, "cgroup_promotion:%ld\n", atomic_long_read(&memcg->promotion_counter));
+
+    return 0;
+}
+
+static struct cftype memcg_counter_file[] = {
+    {
+	.name = "promotion_counter",
