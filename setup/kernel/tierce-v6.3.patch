+#ifdef CONFIG_MMCTL
+/*
+ * The node for a new page of a task whose memory cgroup has per-node limits
+ * (memory.max_at_node<N>). Let nid be the node of the faulting CPU, or the
+ * first node of an MPOL_PREFERRED policy. Below its limit on nid the page
+ * comes from nid; at the limit it comes from the next lower tier of nid,
+ * unless that node is at its limit too. Returns NUMA_NO_NODE when the
+ * memory policy decides: no limits, no limit on nid, no lower tier, or
+ * both nodes at their limits.
+ *
+ * The memcg of current is read under RCU and pinned with css_tryget(), so
+ * a concurrent move of the task to another cgroup cannot free it here.
+ */
+static int mmctl_alloc_node(struct mempolicy *pol, int node, int order)
+{
+	struct mem_cgroup *memcg;
+	unsigned long max_nr_pages;
+	int nid = pol->mode == MPOL_PREFERRED ? first_node(pol->nodes) : node;
+	unsigned int nr_pages = 1U << order;
+	int ret = NUMA_NO_NODE;
+
+	rcu_read_lock();
+	memcg = mem_cgroup_from_task(current);
+	if (memcg && !css_tryget(&memcg->css))
+		memcg = NULL;
+	rcu_read_unlock();
+	if (!memcg)
+		return NUMA_NO_NODE;
+
+	if (!memcg_nodectl_status(memcg))
+		goto out;
+
+	max_nr_pages = memcg_get_node_limit(memcg, nid);
+	if (max_nr_pages == ULONG_MAX)
+		goto out;
+
+	if (max_nr_pages <= memcg_get_node_usedpages(memcg, NODE_DATA(nid)) + nr_pages) {
+		int fallback_nid = next_demotion_node(nid);
+		unsigned long fallback_limit;
+
+		/* No demotion target: the memory policy decides. */
+		if (fallback_nid == NUMA_NO_NODE)
+			goto out;
+
+		/* Fallback node also at limit: the memory policy decides. */
+		fallback_limit = memcg_get_node_limit(memcg, fallback_nid);
+		if (fallback_limit != ULONG_MAX &&
+		    fallback_limit <= memcg_get_node_usedpages(memcg, NODE_DATA(fallback_nid)) +
+				      nr_pages)
+			goto out;
+		nid = fallback_nid;
+	}
+	ret = nid;
+out:
+	css_put(&memcg->css);
+	return ret;
+}
+#endif
